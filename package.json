{
  "name": "amazon-scraper",
  "version": "4.0.0",
  "description": "Containerized Amazon scraper (Docker + Playwright) for BSR, search and product detail pages. Credentials are supplied at run time, never baked into the image.",
  "main": "assets/amazon_handler.js",
  "scripts": {
    "test": "node assets/main_handler.js https://www.amazon.com/gp/bestsellers/electronics",
    "setup": "bash scripts/setup.sh"
  },
  "keywords": [
    "amazon",
    "scraper",
    "asin",
    "bsr",
    "playwright",
    "openclaw",
    "docker"
  ],
  "author": "Joseph",
  "license": "MIT",
  "dependencies": {
    "playwright": "1.40.0"
  },
  "openclaw": {
    "requires": {
      "docker": true
    },
    "requiredBinaries": ["docker"]
  }
}
